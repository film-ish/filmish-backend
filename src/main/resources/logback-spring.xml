<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!-- 컨테이너 환경에 맞는 로그 경로 설정 -->
  <property name="LOG_PATH" value="/var/log/springboot"/>

  <!-- 콘솔 출력 설정 -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
      <charset>utf8</charset>
    </encoder>
  </appender>

  <!-- DEBUG 레벨 JSON 파일 설정 -->
  <appender name="DEBUG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/debug/knockknock-backend-debug.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/debug/knockknock-backend-debug.json.%d{yyyy-MM-dd}</fileNamePattern>
      <maxHistory>7</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
    </rollingPolicy>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>DEBUG</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeMdc>true</includeMdc>
      <includeContext>true</includeContext>
      <customFields>{"application":"knockknock-backend","environment":"${SPRING_PROFILES_ACTIVE:-prod}","container_id":"${HOSTNAME}","log_level":"DEBUG"}</customFields>
    </encoder>
  </appender>

  <!-- INFO 레벨 JSON 파일 설정 -->
  <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/info/knockknock-backend-info.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/info/knockknock-backend-info.json.%d{yyyy-MM-dd}</fileNamePattern>
      <maxHistory>7</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
    </rollingPolicy>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>INFO</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeMdc>true</includeMdc>
      <includeContext>true</includeContext>
      <customFields>{"application":"knockknock-backend","environment":"${SPRING_PROFILES_ACTIVE:-prod}","container_id":"${HOSTNAME}","log_level":"INFO"}</customFields>
    </encoder>
  </appender>

  <!-- WARN 레벨 JSON 파일 설정 -->
  <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/warn/knockknock-backend-warn.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/warn/knockknock-backend-warn.json.%d{yyyy-MM-dd}</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>WARN</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeMdc>true</includeMdc>
      <includeContext>true</includeContext>
      <customFields>{"application":"knockknock-backend","environment":"${SPRING_PROFILES_ACTIVE:-prod}","container_id":"${HOSTNAME}","log_level":"WARN"}</customFields>
    </encoder>
  </appender>

  <!-- ERROR 레벨 JSON 파일 설정 -->
  <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/error/knockknock-backend-error.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/error/knockknock-backend-error.json.%d{yyyy-MM-dd}</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>ERROR</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeMdc>true</includeMdc>
      <includeContext>true</includeContext>
      <customFields>{"application":"knockknock-backend","environment":"${SPRING_PROFILES_ACTIVE:-prod}","container_id":"${HOSTNAME}","log_level":"ERROR"}</customFields>
    </encoder>
  </appender>

  <!-- 로그 레벨 설정 -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="DEBUG_FILE"/>
    <appender-ref ref="INFO_FILE"/>
    <appender-ref ref="WARN_FILE"/>
    <appender-ref ref="ERROR_FILE"/>
  </root>

  <!-- 특정 패키지 로그 레벨 설정 -->
  <logger name="org.springframework" level="INFO"/>
  <logger name="org.hibernate" level="INFO"/>
  <!-- 본인 애플리케이션 패키지 로그 레벨 -->
  <logger name="com.knockknock" level="DEBUG"/>
</configuration>